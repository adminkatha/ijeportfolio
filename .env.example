# Copy this file to .env.local and fill in the values. Never commit .env.local or any real secret.
# On Vercel, add the same variables under Project → Settings → Environment Variables (docs/DEPLOY.md).
# These are read when the site is built: after changing them, rebuild (run-local.bat does) or redeploy.

# Production site URL, used for canonical URLs, the sitemap and Open Graph images.
# [FILL IN: domain not decided yet, e.g. https://example.com]
# Leave it empty locally (http://localhost:3000 is used). On Vercel, empty falls back to the project's production domain.
SITE_URL=

# Contact form → Google Sheet (setup: docs/CONTACT-SETUP.md). Server-only: never add a NEXT_PUBLIC_ prefix.
# Without both, the contact section shows an "Email me instead" link instead of the form.
# The Google Apps Script web app URL (it ends with /exec):
CONTACT_WEBHOOK_URL=
# A long random secret (at least 16 characters; the setup guide shows how to make one).
# The same value goes in the script's CONTACT_SECRET property.
CONTACT_SECRET=

# Vercel only (docs/DEPLOY.md §5): set to 1 after enabling each product in the Vercel dashboard.
ENABLE_VERCEL_ANALYTICS=
ENABLE_SPEED_INSIGHTS=
